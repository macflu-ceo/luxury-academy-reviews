# ── 어드민 로그인 ─────────────────────────────────────────
# 원하는 비밀번호로 바꾸세요
ADMIN_PASSWORD=바꿔주세요
# 아무 긴 문자열이면 됩니다 (터미널: openssl rand -base64 32)
SESSION_SECRET=바꿔주세요

# ── 저장소 ───────────────────────────────────────────────
# Vercel 대시보드에서 Blob 스토어를 만들어 프로젝트에 연결하면 자동으로 채워집니다.
# 로컬에서는 비워두세요. .data/ 폴더에 파일로 저장됩니다.
BLOB_READ_WRITE_TOKEN=

# ── 구글 시트 (상담신청 보기용 사본) ─────────────────────
# 비워두면 시트 연동 없이 동작합니다. 창업설명회 랜딩과 같은 서비스계정·시트를 씁니다.
# 시트에 '후기페이지_상담신청' 탭이 자동으로 생깁니다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=
# (선택) 탭 이름을 바꾸려면
GOOGLE_SHEET_TAB=
